# Copia este archivo como .env y completa tus valores

# Ruta al dataset de Kaggle (database.sqlite)
KAGGLE_DB_PATH=data/raw/kaggle/database.sqlite

# Directorios para datasets enriquecidos de Kaggle.
# Requiere credenciales locales en C:\Users\Leandro\.kaggle\kaggle.json
KAGGLE_ELO_DIR=data/raw/kaggle/international_elo
KAGGLE_MATCH_FEATURES_DIR=data/raw/kaggle/match_features

# Directorio de datos de soccerdata (opcional, por defecto usa el caché interno)
# SOCCERDATA_DIR=data/raw

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
